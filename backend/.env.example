ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql://spenduser:spendpass@localhost:5432/spendintel
QDRANT_URL=http://localhost:6333
# Lasciare vuoto in locale (Qdrant self-hosted via docker-compose non ne ha
# bisogno). In produzione con Qdrant Cloud (free tier), incollare qui la
# API key del cluster.
QDRANT_API_KEY=
QDRANT_COLLECTION=spend_documents
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

OLLAMA_HOST=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=30

# Fallback gratuito quando Ollama non e' raggiungibile (es. in produzione su
# Render, dove non gira un modello locale). Chiave gratuita su console.groq.com
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT=30

# Fallback gratuito per gli embeddings quando Ollama non e' raggiungibile
# (Groq non offre un endpoint embeddings). Chiave gratuita (1M token free,
# nessuna carta richiesta) su jina.ai
JINA_API_KEY=
JINA_EMBED_MODEL=jina-embeddings-v3
JINA_TIMEOUT=30

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=50

ANOMALY_ZSCORE_THRESHOLD=2.5
DUPLICATE_SIMILARITY_THRESHOLD=0.88
